# shellcheck shell=bash

# Runtime config for the production receiver.
# Network / RabbitMQ lives in config/network.env.

# --- Common ---
# LOG_LEVEL: TRACE / DEBUG / INFO / WARN / ERROR
LOG_LEVEL="${LOG_LEVEL:-WARN}"
# [>=0] 0 disables periodic status summary logging.
LOG_STATUS_INTERVAL_SEC="${LOG_STATUS_INTERVAL_SEC:-0}"
# [>=1] MQ receive timeout in seconds.
EXT_TIMEOUT_SEC="${EXT_TIMEOUT_SEC:-300}"
# [0/1] Purge result / traffic queues on startup.
PURGE_MQ_ON_START="${PURGE_MQ_ON_START:-1}"
# [>=0] Allowed timestamp skew before messages are treated as stale.
TS_MAX_SKEW_SEC="${TS_MAX_SKEW_SEC:-100000000}"
# [0/1] Include path payloads in debug result dumps.
DEBUG_INCLUDE_PATH_RESULT="${DEBUG_INCLUDE_PATH_RESULT:-0}"
# Optional file override; empty means auto-pick inside script/start.sh.
MAP_CACHE_FILE="${MAP_CACHE_FILE:-}"

# --- Path Planning ---
# [0/1] 1 = skip static table and use pure A*.
SKIP_STATIC_TABLE="${SKIP_STATIC_TABLE:-1}"
# Static table file used when SKIP_STATIC_TABLE=0.
PLANNER_STATIC_TABLE="${PLANNER_STATIC_TABLE:-${ROOT_DIR}/config/south_20260107_all.bin}"
# [>=0 mm] Base turn penalty used by A* / static planner.
PLANNER_TURN_PENALTY_MM="${PLANNER_TURN_PENALTY_MM:-3000}"
# [>=0] Retry-stage turn-penalty ratio relative to PLANNER_TURN_PENALTY_MM.
PLANNER_TURN_PENALTY_RETRY_RATIO="${PLANNER_TURN_PENALTY_RETRY_RATIO:-0.3333333333}"
# [>=0 mm] Last-resort turn penalty for extreme fallback searches.
PLANNER_TURN_PENALTY_LAST_RESORT_MM="${PLANNER_TURN_PENALTY_LAST_RESORT_MM:-0}"
# [>=0 mm] Obstacle-to-node blocking radius for around-path replans.
OBSTACLE_BLOCK_NODE_MM="${OBSTACLE_BLOCK_NODE_MM:-300}"
# [>=0 mm] Obstacle-to-edge blocking radius for around-path replans.
OBSTACLE_BLOCK_EDGE_MM="${OBSTACLE_BLOCK_EDGE_MM:-300}"
# [>=2] Minimum nodes to treat a linear resource strip as a corridor.
CORRIDOR_MIN_LENGTH="${CORRIDOR_MIN_LENGTH:-3}"
# [>=1] Minimum straight bridge-body nodes before enabling bridge group logic.
CONGESTION_REGION_BRIDGE_MIN_NODES="${CONGESTION_REGION_BRIDGE_MIN_NODES:-4}"
# [>=0] Number of automatically detected congestion regions; 0 disables region seed split.
CONGESTION_REGION_COUNT="${CONGESTION_REGION_COUNT:-0}"
# [>=1] Small-window breadth for region growth.
CONGESTION_REGION_WINDOW="${CONGESTION_REGION_WINDOW:-2}"
# [>=1] Large-window breadth for region growth.
CONGESTION_REGION_BIG_WINDOW="${CONGESTION_REGION_BIG_WINDOW:-2}"
# [0/1] Whether congestion-region hard blocks become real A* hard obstacles.
CONGESTION_REGION_HARD_BLOCK="${CONGESTION_REGION_HARD_BLOCK:-1}"

# --- Reservation / Replan / Traffic ---
# [>=1] Trail publish length; reservation window is clipped to this by default.
TRAIL_MAX_POINTS="${TRAIL_MAX_POINTS:-6}"
# [>=0 ms] TTL for newly reserved path nodes.
RESERVE_TTL_MS="${RESERVE_TTL_MS:-15000}"
# [>=0 ms] TTL for already committed nodes kept in the published trail.
RESERVE_COMMITTED_TTL_MS="${RESERVE_COMMITTED_TTL_MS:-15000}"
# [>=0 ms] Release reservations after status stream is stale this long.
STATUS_STALE_RELEASE_MS="${STATUS_STALE_RELEASE_MS:-60000}"
# [0/1] Use status.nextDestination as committed-next-node hint.
USE_STATUS_NEXT_NODE="${USE_STATUS_NEXT_NODE:-0}"
# [0/1] Release path reservations when a robot is idle.
STATUS_IDLE_RELEASE_ENABLE="${STATUS_IDLE_RELEASE_ENABLE:-0}"
# [>=0 mm/s] Speed threshold for considering an AGV statically waiting.
STATUS_STATIC_SPEED_EPS="${STATUS_STATIC_SPEED_EPS:-20}"
# [-1 or >=0 ms] Static-wait reservation release threshold; -1 disables.
STATUS_STATIC_RELEASE_MS="${STATUS_STATIC_RELEASE_MS:--1}"
# [>=50 ms] Periodic traffic-path publish interval.
TRAFFIC_PATH_PUBLISH_INTERVAL_MS="${TRAFFIC_PATH_PUBLISH_INTERVAL_MS:-1000}"
# [0/1] Send traffic path as growing prefix instead of full current route.
TRAFFIC_PATH_SEND_GROWING="${TRAFFIC_PATH_SEND_GROWING:-0}"
# [>=20 ms] Dynamic replan tick interval.
REPLAN_TICK_MS="${REPLAN_TICK_MS:-200}"
# Compatibility knobs kept for legacy scripts.
REPLAN_INTERVAL_MS="${REPLAN_INTERVAL_MS:-1000}"
REPLAN_INTERVAL_MIN_MS="${REPLAN_INTERVAL_MIN_MS:-500}"
REPLAN_INTERVAL_MAX_MS="${REPLAN_INTERVAL_MAX_MS:-1500}"
# [0/1] Enable near-goal keep-old check.
REPLAN_NEAR_GOAL_CHECK="${REPLAN_NEAR_GOAL_CHECK:-0}"
# [>=0 mm] Near-goal distance threshold for keep-old check.
REPLAN_NEAR_GOAL_MM="${REPLAN_NEAR_GOAL_MM:-10000}"
# [0/1] Enable FAST soft time-window penalties.
REPLAN_SOFT_TIME_WINDOW_ENABLE="${REPLAN_SOFT_TIME_WINDOW_ENABLE:-0}"
# [>=0 ms] Waiting this long upgrades FAST to MAJOR replan.
REPLAN_MAJOR_STUCK_MS="${REPLAN_MAJOR_STUCK_MS:-2000}"
# [>=1] After this many MAJOR failures, upgrade to SUPER replan.
REPLAN_SUPER_AFTER_MAJOR_FAILS="${REPLAN_SUPER_AFTER_MAJOR_FAILS:-10}"
# [>=0 m] Graph-distance neighborhood radius for FAST hard conflicts; 0 disables.
FAST_NEIGHBORHOOD_M="${FAST_NEIGHBORHOOD_M:-3.0}"
# [>=1.0] If FAST route cost exceeds shortest A* cost * ratio, keep current reservation.
FAST_MAX_DETOUR_RATIO="${FAST_MAX_DETOUR_RATIO:-1.8}"
# [0/1] Emit compact traffic-path line logs.
TRAFFIC_PATH_LINE_LOG_ENABLE="${TRAFFIC_PATH_LINE_LOG_ENABLE:-0}"

# --- Deadlock / Yield ---
# [0/1] Enable deadlock detection and temporary yielding.
DEADLOCK_DETECTION_ENABLE="${DEADLOCK_DETECTION_ENABLE:-1}"
# [>=0 ms] Poll interval for deadlock-edge detection.
DEADLOCK_DETECT_MS="${DEADLOCK_DETECT_MS:-2000}"
# [>=0 ms] Stale timeout for remembered blocking edges.
DEADLOCK_EDGE_STALE_MS="${DEADLOCK_EDGE_STALE_MS:-5000}"
# [>=0 mm/s] Speed threshold for treating an AGV as stalled.
DEADLOCK_SPEED_EPS_MM_S="${DEADLOCK_SPEED_EPS_MM_S:-1.0}"
# [>=0 ms] Base yield duration once a victim is chosen.
DEADLOCK_YIELD_MS="${DEADLOCK_YIELD_MS:-3000}"
# [>=DEADLOCK_YIELD_MS ms] Max escalated yield duration.
DEADLOCK_YIELD_MAX_MS="${DEADLOCK_YIELD_MAX_MS:-15000}"
# [>=0 ms] Window used to merge repeated deadlock observations.
DEADLOCK_HISTORY_WINDOW_MS="${DEADLOCK_HISTORY_WINDOW_MS:-30000}"
# [>=1] Stall threshold multiplier relative to replan tick.
DEADLOCK_STALL_MULTIPLIER="${DEADLOCK_STALL_MULTIPLIER:-5}"

# --- Task Allocation ---
# [>=0 s] Task age threshold before aging bonus starts.
ALLOC_TASK_AGE_THRESHOLD_SEC="${ALLOC_TASK_AGE_THRESHOLD_SEC:-300}"
# [>=0 ms/s] Aging bonus slope once threshold is exceeded.
ALLOC_TASK_AGE_BONUS_MS_PER_SEC="${ALLOC_TASK_AGE_BONUS_MS_PER_SEC:-100}"
# [>=0 ms] Upper bound for task aging bonus.
ALLOC_TASK_AGE_BONUS_MAX_MS="${ALLOC_TASK_AGE_BONUS_MAX_MS:-120000}"
# [<=0 ms] Lower clamp applied after aging bonus.
ALLOC_TASK_AGE_MIN_COST_MS="${ALLOC_TASK_AGE_MIN_COST_MS:--60000}"
# [>=0] Congestion multiplier applied inside allocator costs.
ALLOC_CONGESTION_PENALTY_RATIO="${ALLOC_CONGESTION_PENALTY_RATIO:-1.2}"
# [>=0] Waiting penalty coefficient in task allocation.
ALLOC_WAIT_PENALTY_COEFF="${ALLOC_WAIT_PENALTY_COEFF:-0.5}"
# (0,1] Candidate-ratio pruning for allocator search.
ALLOC_TOPK_RATIO="${ALLOC_TOPK_RATIO:-0.8}"
# [>=1] Max tasks handled in a single allocation batch.
ALLOC_MAX_BATCH_SIZE="${ALLOC_MAX_BATCH_SIZE:-200}"

# --- Logging / Debug Artifacts ---
# Directory used by script/start.sh for receiver logs and cache files.
DEBUG_DIR="${DEBUG_DIR:-${ROOT_DIR}/debug}"
# [>=1] Number of rotated receiver logs to keep.
RECEIVER_LOG_KEEP="${RECEIVER_LOG_KEEP:-288}"
# [>=0 s] Rotation interval for receiver logs; 0 disables timed rotation.
RECEIVER_LOG_ROTATE_SEC="${RECEIVER_LOG_ROTATE_SEC:-300}"
# Prefix used for receiver log file names.
RECEIVER_LOG_PREFIX="${RECEIVER_LOG_PREFIX:-external_receiver}"
# Log rotation helper script.
ROTATE_SCRIPT="${ROTATE_SCRIPT:-${ROOT_DIR}/script/rotating_tee.sh}"
# [>=0] Max number of dumped result JSON files kept on disk.
RESULT_DUMP_KEEP_MAX="${RESULT_DUMP_KEEP_MAX:-200}"
# Empty disables result JSON dumping.
RESULT_DUMP_DIR="${RESULT_DUMP_DIR:-}"
