# Network configuration for RabbitMQ-based scheduling I/O
# Usage: source this file before running tools, e.g.
#   source config/network.env

# --- RabbitMQ server ---
# 网络环境经常会变（Wi‑Fi/有线/DHCP），不建议把本机 IP 写死到仓库里。
# - 同机进程（算法/仿真都在本机）：默认用 127.0.0.1 最稳
# - 容器/跨机器访问 RabbitMQ：运行前手动 export AMQP_HOST=<本机网卡 IP>
export AMQP_HOST="${AMQP_HOST:-127.0.0.1}"
export AMQP_PORT="${AMQP_PORT:-5672}"
export AMQP_USER="${AMQP_USER:-gms}"
export AMQP_PASS="${AMQP_PASS:-123456}"
export AMQP_VHOST="${AMQP_VHOST:-/}"
## 可选：与前端一致的单一URL（若设置，将覆盖上面的 AMQP_*）
export RABBITMQ_URL="${RABBITMQ_URL:-amqp://${AMQP_USER}:${AMQP_PASS}@${AMQP_HOST}:${AMQP_PORT}/%2F}"

# --- External (frontend/business) channel ---
# Must match业务MQ规范
export EXT_EXCHANGE="${EXT_EXCHANGE:-DispToAlgoExchange}"
export EXT_EXCHANGE_TYPE="${EXT_EXCHANGE_TYPE:-fanout}"
export EXT_QUEUE="${EXT_QUEUE:-DispToAlgoQueue}"
export EXT_ROUTING_KEY="${EXT_ROUTING_KEY:-AssignmentTaskRequest}"
export EXT_BINDING_KEY="${EXT_BINDING_KEY:-#}"
# 默认不设置消息 TTL，如需覆盖可手动 export EXT_MESSAGE_TTL_MS=5000 等
# 默认不设置队列优先级，如需兼容 x-max-priority=10，可手动 export EXT_QUEUE_MAX_PRIORITY=10

# --- Routing keys for map/status/path/trail requests ---
# 仿真端 / sender 工具里会优先读取这些变量；若不设置，则某些脚本会用 EXT_ROUTING_KEY 进行“全局覆盖”，
# 导致 external_receiver 无法区分 task vs path/trail 请求。
export MAP_ROUTING_KEY="${MAP_ROUTING_KEY:-SendMapInfo}"
export STATUS_ROUTING_KEY="${STATUS_ROUTING_KEY:-SendRobotStatusInfos}"
export PATH_REQUEST_ROUTING_KEY="${PATH_REQUEST_ROUTING_KEY:-RobotPathRequest}"
export TRAIL_REQUEST_ROUTING_KEY="${TRAIL_REQUEST_ROUTING_KEY:-RobotTrailRequest}"
# --- Path/Trail request sender defaults ---
# 留空则自动生成 messageId
export PATH_REQUEST_MESSAGE_ID="${PATH_REQUEST_MESSAGE_ID:-}"
export PATH_REQUEST_DEVICE_ID="${PATH_REQUEST_DEVICE_ID:-AGV01}"
export TRAIL_REQUEST_MESSAGE_ID="${TRAIL_REQUEST_MESSAGE_ID:-}"
export TRAIL_REQUEST_DEVICE_ID="${TRAIL_REQUEST_DEVICE_ID:-AGV01}"
# 可选：指定 trail 请求的 subTaskId
export TRAIL_REQUEST_SUBTASK_ID="${TRAIL_REQUEST_SUBTASK_ID:-}"

# --- Internal (optional) channel ---
# If you keep internal sender/receiver flows, you can set these too
# (Only used if the internal tools are wired to read them.)
export ALLOC_EXCHANGE="${ALLOC_EXCHANGE:-alloc_exchange}"
export ALLOC_QUEUE="${ALLOC_QUEUE:-alloc_queue}"
export ALLOC_ROUTING_KEY="${ALLOC_ROUTING_KEY:-alloc.input}"

# --- Result channel (Algo -> Disp) ---
export ASSIGN_RESULT_EXCHANGE="${ASSIGN_RESULT_EXCHANGE:-AlgoToDispExchange}"
export ASSIGN_RESULT_QUEUE="${ASSIGN_RESULT_QUEUE:-AlgoToDispQueue}"
export ASSIGN_RESULT_ROUTING_KEY="${ASSIGN_RESULT_ROUTING_KEY:-AssignmentTaskResponse}"
export ASSIGN_RESULT_BINDING_KEY="${ASSIGN_RESULT_BINDING_KEY:-#}"
# 结果队列默认不设置 TTL，如需覆盖可手动 export ASSIGN_RESULT_TTL_MS=5000

# --- Algo publisher channel (Algo -> Disp 控制/响应) ---
# 这些 routing key/队列用于服务初始化、心跳、路径/轨迹响应等消息
export ALGO_PUBLISH_EXCHANGE="${ALGO_PUBLISH_EXCHANGE:-AlgoToDispExchange}"
export ALGO_PUBLISH_QUEUE="${ALGO_PUBLISH_QUEUE:-AlgoToDispQueue}"
export ALGO_PUBLISH_BINDING_KEY="${ALGO_PUBLISH_BINDING_KEY:-#}"
# 可选：如需设置 TTL，启动前 export ALGO_PUBLISH_TTL_MS=5000
export ALGO_INIT_ROUTING_KEY="${ALGO_INIT_ROUTING_KEY:-AlgoServiceInitialize}"
export ALGO_HEARTBEAT_ROUTING_KEY="${ALGO_HEARTBEAT_ROUTING_KEY:-AlgoServiceHeartbeat}"
export ALGO_RUNINFO_ROUTING_KEY="${ALGO_RUNINFO_ROUTING_KEY:-SendRunInfo}"
export ALGO_ALERT_ROUTING_KEY="${ALGO_ALERT_ROUTING_KEY:-SendAlertInfo}"
export ALGO_PATH_RESPONSE_ROUTING_KEY="${ALGO_PATH_RESPONSE_ROUTING_KEY:-RobotPathResponse}"
export ALGO_TRAIL_RESPONSE_ROUTING_KEY="${ALGO_TRAIL_RESPONSE_ROUTING_KEY:-RobotTrailResponse}"

# --- Traffic path channel (Algo -> Traffic) ---
export TRAFFIC_PATH_EXCHANGE="${TRAFFIC_PATH_EXCHANGE:-AlgoToTrafficExchange}"
export TRAFFIC_PATH_QUEUE="${TRAFFIC_PATH_QUEUE:-AlgoToTrafficQueue}"
export TRAFFIC_PATH_ROUTING_KEY="${TRAFFIC_PATH_ROUTING_KEY:-SendPathInfo}"
export TRAFFIC_PATH_BINDING_KEY="${TRAFFIC_PATH_BINDING_KEY:-#}"
# 可选：如需设置 TTL，启动前 export TRAFFIC_PATH_TTL_MS=5000

# --- Notes ---
# Logic/tuning defaults moved to settings/production.env and loaded by script/start.sh.
# Simulation-only defaults moved to simulation_v2/run_all.sh.
